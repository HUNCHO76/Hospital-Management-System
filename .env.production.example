# ==============================================================================
# St. Joseph DMI Hospital Management System (HMS-NHIF)
# Production Environment Deployment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env on the production host: cp .env.production.example .env
# 2. Generate a fresh application key: php artisan key:generate
# 3. Populate genuine MySQL, Redis, Mail, and NHIF credentials.
# 4. Never commit this file or the live .env into source control.
# 5. Ensure web root points strictly to /public and permissions are:
#    - Directories: 755, Files: 644
#    - storage/ and bootstrap/cache/: writable by web server (e.g. www-data)
# ==============================================================================

APP_NAME="St. Joseph DMI Hospital HMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=https://hms.stjosephhospital.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Database Connection (Hardened Production MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hms_nhif_prod
DB_USERNAME=hms_db_user
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD
DB_STRICT_MODE=true

# Session Security (Enforced over HTTPS)
SESSION_DRIVER=database
# 15-minute idle timeout recommended for shared hospital workstations
SESSION_LIFETIME=15
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sensitive-action re-authentication window (in seconds, 900 = 15 minutes)
AUTH_PASSWORD_TIMEOUT=900

# Queue & Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=hms_cache

# Mailer Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@stjosephhospital.org"
MAIL_FROM_NAME="St. Joseph DMI Hospital"

# NHIF OCS Production Integration
# In production, use official production ServiceHub and OCS endpoints provided by NHIF
NHIF_AUTH_URL=https://servicehub.nhif.or.tz/auth/connect/token
NHIF_SERVICEHUB_BASE_URL=https://servicehub.nhif.or.tz/servicehub
NHIF_OCS_BASE_URL=https://ocs.nhif.or.tz/ocs
NHIF_CLIENT_ID=REPLACE_WITH_FACILITY_NHIF_CLIENT_ID
NHIF_CLIENT_SECRET=REPLACE_WITH_FACILITY_NHIF_CLIENT_SECRET
NHIF_USERNAME=REPLACE_WITH_FACILITY_NHIF_USERNAME
NHIF_TIMEOUT=30
NHIF_CONNECT_TIMEOUT=10
NHIF_TOKEN_CACHE_KEY=nhif_access_token_prod
NHIF_TOKEN_EXPIRY_BUFFER=60

# API & NHIF Rate Limiting (Requests per minute)
API_RATE_LIMIT_AUTH=5
API_RATE_LIMIT_STANDARD=60
API_RATE_LIMIT_NHIF_VERIFICATION=15

# Content Security Policy (Leave empty to use secure defaults defined in SecurityHeaders middleware)
CONTENT_SECURITY_POLICY=

# Database Automated Backup Settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=storage/app/backups
BACKUP_GZIP=true

# Reverse Proxy / Load Balancer
TRUSTED_PROXIES=127.0.0.1
